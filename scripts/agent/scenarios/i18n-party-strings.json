    {"do":"eval","expr":"G.toast_overlay.show_toast(G.tr('PARTY.TOO_LARGE_FOR_MODE') % [3, 2])","comment":"the toast a party leader sees when the party is too big for the mode"},
    {"do":"wait","sec":0.6},
    {"do":"assert","expr":"ui_labels(str(G.side_panel_layer.get_path())).has(G.tr('PARTY.EMPTY_STATE_HINT'))","message":"the ru party hint is on screen"},
    {"do":"assert","expr":"ui_labels(str(G.toast_overlay.get_path())).has(G.tr('PARTY.TOO_LARGE_FOR_MODE') % [3, 2])","message":"the ru party-size toast is on screen"},
    {"do":"screenshot","name":"ru-party"},
    {"do":"eval","expr":"G.side_panel_layer.get_child(G.side_panel_layer.get_child_count() - 1).get_node('%PanelStack').get_child(1).open_confirm_dialog(G.tr('CONFIRM.REMOVE_FRIEND') % 'Bunbun', G.tr('FRIENDS.REMOVE'), Callable(), G.tr('CONFIRM.CANCEL'))","comment":"the dialog the friend details panel opens"},
    {"do":"wait","sec":0.4},
    {"do":"assert","expr":"ui_labels(str(G.confirm_layer.get_path())).has(G.tr('CONFIRM.REMOVE_FRIEND') % 'Bunbun')","message":"the ru remove-friend question is on screen"},
    {"do":"screenshot","name":"ru-remove-friend"},
