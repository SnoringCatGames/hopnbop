{
  "name": "i18n-party-strings",
  "mode": "lobby",
  "timeout_sec": 120,
  "comment": "Renders the strings a comma once shifted across locales (PARTY.EMPTY_STATE_HINT, PARTY.TOO_LARGE_FOR_MODE) and the corrected Chinese CONFIRM.REMOVE_FRIEND, in the real party panel, toast, and confirm dialog, one screenshot pair per locale.",
  "steps": [
    {"do":"wait_ready"},
    {"do":"tap","key":"move_up","player":1,"hold_sec":0.3},
    {"do":"wait_until","expr":"player_count() == 1","timeout_sec":5,"comment":"a bunny joined, so the settings panels have a player to belong to"},
    {"do":"eval","expr":"G.local_settings.set_locale('ja')"},
    {"do":"eval","expr":"G.side_panel_layer.add_child(Engine.get_singleton('ResourceLoader').load('res://src/ui/settings_panel/side_panel_manager.tscn').instantiate())"},
    {"do":"eval","expr":"G.side_panel_layer.get_child(G.side_panel_layer.get_child_count() - 1).open(players()[0])"},
    {"do":"eval","expr":"G.side_panel_layer.get_child(G.side_panel_layer.get_child_count() - 1).push_panel(Engine.get_singleton('ResourceLoader').load('res://src/ui/party/party_lobby_panel.tscn').instantiate())","comment":"no party, so the panel shows PARTY.EMPTY_STATE_HINT"},
    {"do":"eval","expr":"G.toast_overlay.show_toast(G.tr('PARTY.TOO_LARGE_FOR_MODE') % [3, 2])","comment":"the toast a party leader sees when the party is too big for the mode"},
    {"do":"wait","sec":0.6},
    {"do":"assert","expr":"ui_labels(str(G.side_panel_layer.get_path())).has(G.tr('PARTY.EMPTY_STATE_HINT'))","message":"the ja party hint is on screen"},
    {"do":"assert","expr":"ui_labels(str(G.toast_overlay.get_path())).has(G.tr('PARTY.TOO_LARGE_FOR_MODE') % [3, 2])","message":"the ja party-size toast is on screen"},
    {"do":"screenshot","name":"ja-party"},
    {"do":"eval","expr":"G.side_panel_layer.get_child(G.side_panel_layer.get_child_count() - 1).get_node('%PanelStack').get_child(1).open_confirm_dialog(G.tr('CONFIRM.REMOVE_FRIEND') % 'Bunbun', G.tr('FRIENDS.REMOVE'), Callable(), G.tr('CONFIRM.CANCEL'))","comment":"the dialog the friend details panel opens"},
    {"do":"wait","sec":0.4},
    {"do":"assert","expr":"ui_labels(str(G.confirm_layer.get_path())).has(G.tr('CONFIRM.REMOVE_FRIEND') % 'Bunbun')","message":"the ja remove-friend question is on screen"},
    {"do":"screenshot","name":"ja-remove-friend"},
    {"do":"eval","expr":"G.confirm_layer.get_child(G.confirm_layer.get_child_count() - 1).queue_free()"},
    {"do":"eval","expr":"G.side_panel_layer.get_child(G.side_panel_layer.get_child_count() - 1).close_all()"},
    {"do":"wait","sec":0.8},
    {"do":"eval","expr":"G.local_settings.set_locale('ru')"},
    {"do":"eval","expr":"G.side_panel_layer.add_child(Engine.get_singleton('ResourceLoader').load('res://src/ui/settings_panel/side_panel_manager.tscn').instantiate())"},
    {"do":"eval","expr":"G.side_panel_layer.get_child(G.side_panel_layer.get_child_count() - 1).open(players()[0])"},
