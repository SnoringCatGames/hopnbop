{
  "name": "log-out-sign-in-cycles",
  "mode": "lobby",
  "timeout_sec": 90,
  "steps": [
    {"do": "wait_ready"},
    {"do": "eval", "name": "sign_in", "expr": "Platform.token_store.store_from_response({'jwt_token': 'agent.' + Engine.get_singleton('Marshalls').utf8_to_base64('{\"exp\": 4102444800, \"uid\": \"agent-harness\"}') + '.harness', 'refresh_token': 'agent.' + Engine.get_singleton('Marshalls').utf8_to_base64('{\"exp\": 4102444800, \"uid\": \"agent-harness\"}') + '.harness', 'player_id': 'agent-harness', 'provider': 'google', 'display_name': 'Agent', 'expires_at': 4102444800, 'linked_providers': ['google'], 'consent_accepted_at': 1760000000, 'consent_legal_version': G.consent_screen._get_current_legal_version()})", "comment": "A provider session good until 2100, with consent to the current legal version. Every request goes to the harness's blackhole backend and fails."},
    {"do": "eval", "expr": "Platform.auth.auth_completed.emit(true, '')", "comment": "the sign-in completes, as the auth screen's would"},
    {"do": "assert", "expr": "G.friends_notification_poller._is_polling", "message": "the friends poller runs for the signed-in player"},
    {"do": "eval", "expr": "G.set_meta('auth_listeners', Platform.auth.auth_completed.get_connections().size())"},
    {"do": "eval", "expr": "G.set_meta('socket_listeners', Platform.notification_socket.notification_received.get_connections().size())"},
    {"do": "eval", "expr": "G.screens.sign_out_router.log_out()", "comment": "Settings, Log Out. announce_offline waits out the blackhole first."},
    {"do": "wait_until", "expr": "screen() == 'CONSENT'", "timeout_sec": 25},
    {"do": "assert", "expr": "not G.friends_notification_poller._is_polling", "message": "log-out stops the poller"},
    {"do": "assert", "expr": "not Platform.notification_socket._wants_connection", "message": "log-out closes the old account's notification socket"},
    {"do": "assert", "expr": "Platform.token_store.jwt_token.is_empty() and Platform.token_store.refresh_token.is_empty()", "message": "signed out"},
    {"do": "assert", "expr": "Platform.token_store.consent_accepted_at == 0", "message": "log-out forgets consent"},
    {"do": "wait", "sec": 0.3},
    {"do": "assert", "expr": "ui_labels(str(G.toast_overlay.get_path())).has(G.tr('TOAST.LOGGED_OUT'))", "message": "a toast says so"},
    {"do": "screenshot", "name": "consent-after-log-out"},
    {"do": "eval", "expr": "G.consent_screen._on_continue_pressed()", "comment": "the next player consents; the harness skips the auth screen"},
    {"do": "wait_until", "expr": "screen() == 'LOBBY'", "timeout_sec": 5},
    {"do": "eval", "expr": "Platform.auth.login_anonymous()", "comment": "and plays as a guest"},
    {"do": "assert", "expr": "G.friends_notification_poller._is_polling", "message": "a guest sign-in starts the poller again"},
    {"do": "eval", "expr": "G.screens.sign_out_router.log_out()", "comment": "the guest logs out; with no session there is nothing to announce"},
    {"do": "wait_until", "expr": "screen() == 'CONSENT'", "timeout_sec": 10},
    {"do": "assert", "expr": "not G.friends_notification_poller._is_polling", "message": "stopped again"},
    {"do": "eval", "expr": "G.consent_screen._on_continue_pressed()"},
    {"do": "wait_until", "expr": "screen() == 'LOBBY'", "timeout_sec": 5},
    {"do": "eval", "name": "sign_in_again", "expr": "Platform.token_store.store_from_response({'jwt_token': 'agent.' + Engine.get_singleton('Marshalls').utf8_to_base64('{\"exp\": 4102444800, \"uid\": \"agent-harness-2\"}') + '.harness', 'refresh_token': 'agent.' + Engine.get_singleton('Marshalls').utf8_to_base64('{\"exp\": 4102444800, \"uid\": \"agent-harness-2\"}') + '.harness', 'player_id': 'agent-harness-2', 'provider': 'google', 'display_name': 'Agent Two', 'expires_at': 4102444800, 'linked_providers': ['google']})", "comment": "a different provider account signs in"},
    {"do": "eval", "expr": "Platform.auth.auth_completed.emit(true, '')"},
    {"do": "assert", "expr": "G.friends_notification_poller._is_polling", "message": "a provider sign-in starts the poller again"},
    {"do": "assert", "expr": "Platform.notification_socket._wants_connection", "message": "and a notification socket for the new account"},
    {"do": "assert", "expr": "Platform.auth.auth_completed.get_connections().size() == G.get_meta('auth_listeners')", "message": "no sign-in listener was added by the cycles"},
    {"do": "assert", "expr": "Platform.notification_socket.notification_received.get_connections().size() == G.get_meta('socket_listeners')", "message": "no socket listener was added by the cycles"},
    {"do": "assert", "expr": "G.friends_notification_poller._known_friend_event_ids.is_empty() and G.friends_notification_poller.unseen_count == 0", "message": "nothing carried over from the old accounts"},
    {"do": "wait", "sec": 0.5},
    {"do": "screenshot", "name": "lobby-second-account"}
  ]
}
