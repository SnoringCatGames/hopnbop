{
	// Godot-specific settings
	"files.associations": {
		"*.gd": "gdscript",
		"*.tscn": "godot-scene",
		"*.tres": "godot-resource"
	},
	"files.exclude": {
		"**/.git": true,
		"**/.godot": true,
		"**/bin": false,
		"**/.scons_cache": true,
		"**/__pycache__": true
	},
	// Editor settings for GDScript
	"editor.detectIndentation": false,
	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"[gdscript]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 4,
		"editor.formatOnSave": true,
		// "editor.defaultFormatter": "eddiedover.gdscript-formatter-linter",
		"editor.defaultFormatter": "geequlim.godot-tools",
		"editor.rulers": [
			80
		]
	},
	// Godot Tools extension settings
	"godot_tools.editor_path": "",
	"godot_tools.gdscript_lsp_server_port": 6005,
	"godot_tools.editor_server_port": 6007,
	// GDScript Formatter settings
	"gdscriptFormatter.indentType": "Tabs",
	// File formatting
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	// Git settings
	"git.enableSmartCommit": true,
	"git.confirmSync": false,
	// Terminal settings
	"terminal.integrated.defaultProfile.windows": "PowerShell",
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"source": "PowerShell",
			"icon": "terminal-powershell"
		},
		"WSL": {
			"path": "wsl.exe",
			"icon": "terminal-linux"
		}
	},
	// No C++/CMake settings here on purpose. The C_Cpp includePath
	// and cmake.sourceDirectory that used to live here pointed into
	// gamelift-gdextension/, which was deleted with the rest of the
	// GameLift surface in Phase F (2026-05-03). They outlived it by
	// two months, pointing at paths that don't exist, which is just
	// IntelliSense and CMake-extension errors on every open. This
	// repo has no local C++ source: the only GDExtension it consumes
	// is addons/webrtc/ (prebuilt binaries), and the patched
	// webrtc-native build happens inside Dockerfile.edgegap, not in
	// the editor.
	// Search settings
	"search.exclude": {
		"**/.godot": true,
		"**/bin": true,
		"**/.scons_cache": true
	},
	"chat.tools.terminal.autoApprove": {
		"godot": true,
		"Out-File": true
	}
}
